@model AdminX.ViewModels.VhrAuditVM
@{
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title text-dark">VHR Audit Details</h3>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped defaultTable">
            <thead>
                <tr>
                    <th>CGU No</th>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>NHS No</th>
                    <th>VHR letter code</th>
                    <th>Screening Unit</th>
                    <th>Ref sent date</th>
                    <th>Admin Contact</th>
                    <th>Ref received confo date</th>
                </tr>
            </thead>
            <tbody>
             
                    <tr>
                        <td>@Model.vhrAuditDetails.CGU_No</td>
                        <td>@Model.vhrAuditDetails.FIRSTNAME @Model.vhrAuditDetails.LASTNAME</td>
                        <td>@(Model.vhrAuditDetails.DOB != null ? ((DateTime)Model.vhrAuditDetails.DOB).ToString("dd/MM/yyyy") : "")</td>
                        <td>@Model.vhrAuditDetails.SOCIAL_SECURITY</td>
                        <td>@Model.vhrAuditDetails.DocCode</td>
                        <td>@Model.vhrAuditDetails.BreastScreeningService</td>
                        <td>@(Model.vhrAuditDetails.DiaryDate != null ? ((DateTime)Model.vhrAuditDetails.DiaryDate).ToString("dd/MM/yyyy") : "")</td>
                        <td>@(Model.vhrAuditDetails.NAME != null ? Model.vhrAuditDetails.NAME : "")</td>
                    <td>@(Model.vhrAuditDetails.DiaryRec != DateTime.Parse("01/01/1900") ? ((DateTime)Model.vhrAuditDetails.DiaryRec).ToString("dd/MM/yyyy") : "")</td>
                    </tr>
            
            </tbody>
        </table>
    </div>
</div>
